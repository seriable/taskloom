# Source-only Docker build context. Credentials, runtime state and weights are
# excluded even when a new COPY instruction is added later.
**
!Cargo.toml
!Cargo.lock
!src
!src/**
!examples
!examples/**
!tests
!tests/**
!sandbox
!sandbox/**
!docs
!docs/**
!sdks
!sdks/**
!README.md
!README.en.md
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE-*
!deploy
!deploy/Dockerfile
!deploy/entrypoint.sh
**/__pycache__
**/*.pyc
**/*.private*
**/.env
**/.env.*
**/taskloom.json
**/*.dpapi
**/*.safetensors
**/node_modules
**/.venv
sdks/**/build
sdks/**/dist
sdks/**/*.egg-info
