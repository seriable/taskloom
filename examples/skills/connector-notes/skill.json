  "connectors": [
    {
      "id": "local-notes-github",
      "configuration_example": "connector.example.json",
      "tools": [
        "repo_metadata",
        "notes_status",
        "notes_append"
      ],
      "credentials": [
        "TASKLOOM_EXAMPLE_CONNECTOR_TOKEN"
      ],
      "description": "Run the source example MCP service on loopback; repository identity and note directory are host-owned. No service is started or configured by installing this package."
