      "effect": "read_only",
      "permissions": [
        "notes:read"
      ]
    },
    "notes_append": {
      "effect": "non_idempotent",
      "permissions": [
        "notes:write"
      ]
    }
  },
  "credentials": [
    {
      "name": "TASKLOOM_EXAMPLE_CONNECTOR_TOKEN",
      "purpose": "Host-configured bearer token for the explicitly started local example MCP service."
