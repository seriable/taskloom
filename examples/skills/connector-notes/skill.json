{
  "format": 1,
  "name": "connector-notes",
  "version": "1.0.0",
  "description": "Host-bound MCP repository metadata and durable local notes examples.",
  "files": {
    "append.md": "7e9f5865c7f805a4cd3971a326b21a2217b2e94ce4d086200b94ba52e4608951",
