            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "repository",
              "license",
              "summary"
            ],
            "additionalProperties": false
          },
          "max_repairs": 1
        }
      }
    },
    {
      "name": "append",
      "instructions": "append.md",
      "includes": [],
      "tools": [
        "notes_append"
      ],
      "output": {
        "type": "validated",
        "policy": {
          "type": "json_schema",
          "schema": {
            "type": "object",
            "properties": {
              "saved": {
                "const": true
              }
            },
            "required": [
              "saved"
            ],
            "additionalProperties": false
          },
          "max_repairs": 1
        }
      }
    },
    {
      "name": "status",
      "instructions": "status.md",
      "includes": [],
      "tools": [
        "notes_status"
      ],
      "output": {
        "type": "validated",
        "policy": {
          "type": "json_schema",
          "schema": {
            "type": "object",
            "properties": {
              "entries": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "entries"
            ],
            "additionalProperties": false
          },
          "max_repairs": 1
        }
      }
    }
  ],
